# -----------------------------------------------------------------------------
# ControlDesk — Local Development Environment
# Copy this file to `.env.local` and fill in the values below.
# NEVER commit `.env.local` — it is in .gitignore.
# For containerized deployments, use Docker Secrets or your orchestrator's
# secret store — rules §1 forbids hard-coded credentials in images.
# -----------------------------------------------------------------------------

# --- Supabase (local: run `pnpm db:start` and copy from `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="paste-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="paste-service-role-key-here"
# Optional: override the URL used by server-side Supabase clients only.
# Leave unset for `pnpm dev`. Docker Compose sets this to `http://kong:8000`
# so the container talks to Supabase across the shared bridge network
# (see docker-compose.yml → `services.app.environment`).
# SUPABASE_SERVER_URL=""

# --- Tenant routing ---------------------------------------------------------
# In dev, use `localhost:3000` so `{slug}.localhost:3000` subdomains work
# out of the box on macOS / Linux.
# In production, set to e.g. `controldesk.app` so `{slug}.controldesk.app` works.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# --- Application metadata --------------------------------------------------
NEXT_PUBLIC_APP_NAME="ControlDesk"

# --- Enterprise security (rules §3) ----------------------------------------
# Symmetric key used by src/lib/security/crypto.ts + pgcrypto to encrypt
# sensitive HRIS columns (salary, bank_account_number, ktp, npwp).
# MUST be at least 32 characters. Rotate via a controlled re-encryption
# migration; NEVER reuse across environments.
APP_ENCRYPTION_KEY="change-me-to-a-random-32-plus-char-string"

# --- Rate limiting + queues (rules §3) -------------------------------------
# Provided by `redis` service in docker-compose.yml. When unset, the app
# falls back to an in-process memory limiter (fine for local dev only).
REDIS_URL="redis://127.0.0.1:6379"

# --- Dev mail server (docker-compose exposes at http://localhost:8025) -----
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASS=""
SMTP_FROM="ControlDesk <no-reply@controldesk.app>"

# --- Cron authentication (rules §20 / §22) ---------------------------------
# Shared secret between Vercel Cron (or any external scheduler) and the app.
# All /api/cron/* endpoints require:
#   Authorization: Bearer $CRON_SECRET
# Rotate together with SUPABASE_SERVICE_ROLE_KEY (rules §22 secret rotation).
CRON_SECRET="change-me-to-a-random-hex-32-plus"

# --- AI Analytics Engine (rules §15) ---------------------------------------
# Any Vercel AI SDK compatible provider. Pick one and uncomment.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional overrides:
# AI_PROVIDER="openai"           # openai | anthropic | google | mock (default: mock)
# AI_MODEL_ID="gpt-4o-mini"      # provider-specific model id
# AI_DAILY_TOKEN_CAP="10000"     # per-tenant daily output-token budget (rules §15)
#
# ─── Quick-start: Google Gemini FREE tier (Aug 2026) ───────────────────────
# Free: 10 RPM · 250K TPM · 1,500 req/day for gemini-2.5-flash.
# Structured output supported (matches `generateObject` + Zod usage).
# 1. Get API key at https://aistudio.google.com/apikey (no credit card needed).
# 2. Uncomment the 3 lines below and paste the key.
# 3. Restart `pnpm dev`. Insights on /insights now hit Gemini live.
# NOTE: free tier prompts MAY be used by Google to improve models. PII is
# already redacted server-side (`src/lib/ai/redact.ts`), but for strict-
# compliance tenants prefer paid tier (billing linked) or Ollama local.
# AI_PROVIDER="google"
# AI_MODEL_ID="gemini-flash-latest"
# GOOGLE_GENERATIVE_AI_API_KEY="AQ.Ab…"    # Google migrasi format Juni 2026:
#                                            keys baru berawalan AQ.Ab, keys lama
#                                            AIza… akan sunset September 2026.

# --- Observability sink (rules §21) ----------------------------------------
# Pick ONE provider. If both are set, SENTRY_DSN wins unless
# OBSERVABILITY_SINK explicitly forces `axiom`.
#
# Sentry — DSN copied from your project settings (https://sentry.io/*/settings/projects/*/keys/).
# SENTRY_DSN="https://<public-key>@o0.ingest.sentry.io/<project-id>"
#
# Axiom — dataset name + org token (https://app.axiom.co/*/datasets).
# AXIOM_TOKEN="xaat-..."
# AXIOM_DATASET="controldesk-prod"
#
# Optional overrides:
# OBSERVABILITY_SINK="auto"       # auto | sentry | axiom | console | noop
# OBSERVABILITY_ENV="production"  # tag every event with this environment
# RELEASE_TAG="v1.4.2"            # falls back to VERCEL_GIT_COMMIT_SHA / GIT_SHA
#
# The sink receives ONLY `warn` / `error` / `fatal` events. Auth headers,
# cookies, and long hex/base64 tokens are redacted before dispatch. Rotate
# the token/DSN every 90 days alongside CRON_SECRET (rules §22).

# ControlDesk .dockerignore — keep the build context tiny + never leak secrets.

# --- Dependencies ---
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store

# --- Next.js build output ---
.next
out
build

# --- Source control / editor ---
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
.DS_Store

# --- Env / secrets — MUST NOT be baked into the image ---
.env
.env.*
!.env.local.example

# --- Local Supabase runtime state ---
supabase/.branches
supabase/.temp
supabase/.env

# --- Docker meta ---
Dockerfile*
docker-compose*.yml
.dockerignore

# --- Test / CI artefacts ---
coverage
.nyc_output
*.log
test-results
playwright-report

# --- Docs / cursor-only files (already re-generated on `next dev`) ---
AGENTS.md
CLAUDE.md

# --- Misc ---
README.md

{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ControlDesk",
  "short_name": "ControlDesk",
  "description": "Multi-tenant BPO / ERP untuk project, finance, dan HR. Approver dapat notifikasi push langsung di HP.",
  "id": "/",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#0b0f19",
  "theme_color": "#4f46e5",
  "lang": "id",
  "dir": "ltr",
  "categories": ["business", "productivity", "finance"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Approval Inbox",
      "short_name": "Approvals",
      "description": "Buka Approval Inbox untuk approve/reject request.",
      "url": "/approvals?utm_source=pwa_shortcut",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Insights",
      "short_name": "Insights",
      "description": "Buka AI Insights untuk lihat forecast, utilization, dan SLA warning.",
      "url": "/insights?utm_source=pwa_shortcut",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Timesheet",
      "short_name": "Timesheet",
      "description": "Isi timesheet mingguan.",
      "url": "/hr/timesheets?utm_source=pwa_shortcut",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}

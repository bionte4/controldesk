# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local runtime
supabase/.branches/
supabase/.temp/
supabase/.env

# agent scaffolding auto-writes
AGENTS.md
CLAUDE.md

# personal / office scratch files that occasionally land in the repo
# during evaluations, printouts, etc. Not meant to ship with the code.
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
# MS Office lock files (created while a document is open)
~$*


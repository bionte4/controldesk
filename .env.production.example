# =============================================================================
# ControlDesk — Production .env template (single-VPS self-hosted deployment).
# =============================================================================
#
# Copy ke `.env.production` dan isi semua nilai. JANGAN commit `.env.production`
# ke git — sudah di-ignore lewat `.gitignore` (row `.env*` catch-all).
#
# Generator helper (jalankan sekali di terminal, salin outputnya ke slot yang
# sesuai di bawah):
#
#   # Semua secret Postgres/JWT/App:
#   ./deploy/scripts/generate-secrets.sh
#
#   # ANON_KEY + SERVICE_ROLE_KEY (butuh JWT_SECRET dari langkah di atas):
#   ./deploy/scripts/generate-supabase-keys.sh
#
# Cross-reference: rules §22 "Secret Rotation" — rotate minimum tiap 90 hari.

# -----------------------------------------------------------------------------
# DOMAIN & TLS
# -----------------------------------------------------------------------------
# Root domain tanpa protokol. Wildcard subdomain (`*.<ROOT_DOMAIN>`) di-serve
# oleh Caddy dengan cert wildcard.
ROOT_DOMAIN=controldesk.app
# API subdomain — Supabase (Kong) di-fronted di sini. Hit dari browser.
API_DOMAIN=api.controldesk.app
# Email admin untuk Let's Encrypt renewal notification.
ACME_EMAIL=admin@controldesk.app

# Cloudflare API token untuk DNS-01 challenge (butuh scope Zone:DNS:Edit
# di zona ROOT_DOMAIN). Buat di dashboard Cloudflare -> API Tokens.
CF_API_TOKEN=cf-api-token-with-zone-dns-edit-scope

# -----------------------------------------------------------------------------
# NEXT.JS PUBLIC ENV (baked into browser bundle at build time)
# -----------------------------------------------------------------------------
# HTTPS URL Supabase API — browser hit ini untuk auth/rest/realtime/storage.
NEXT_PUBLIC_SUPABASE_URL=https://api.controldesk.app
# `NEXT_PUBLIC_ROOT_DOMAIN` dipakai untuk subdomain-per-tenant + URL builder.
NEXT_PUBLIC_ROOT_DOMAIN=controldesk.app
# Nama aplikasi (dipakai di email subject, invitation, dsb.).
NEXT_PUBLIC_APP_NAME=ControlDesk

# Site URL & redirect list — dipakai GoTrue untuk sanitize post-login redirect.
SITE_URL=https://controldesk.app
# Comma-separated additional redirect URLs (biasanya wildcard subdomain).
ADDITIONAL_REDIRECT_URLS=https://*.controldesk.app
API_EXTERNAL_URL=https://api.controldesk.app

# -----------------------------------------------------------------------------
# POSTGRES (self-hosted di container `db`)
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME_postgres_super_password_min_32_char

# -----------------------------------------------------------------------------
# JWT / SUPABASE KEYS
# -----------------------------------------------------------------------------
# JWT secret — dipakai GoTrue + PostgREST + Realtime untuk sign & validate token.
# Generate: openssl rand -base64 48
# WAJIB min 32 char. Rotate: rules §22 (90 hari).
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_char_openssl_rand_base64_48

# ANON_KEY + SERVICE_ROLE_KEY di-derive dari JWT_SECRET pakai
# ./deploy/scripts/generate-supabase-keys.sh (butuh Node.js).
# ANON_KEY: JWT signed dengan role='anon', 10 tahun expiry.
ANON_KEY=CHANGE_ME_derived_from_JWT_SECRET_via_generate-supabase-keys.sh
# SERVICE_ROLE_KEY: JWT role='service_role' — bypass RLS. Jaga baik-baik!
SERVICE_ROLE_KEY=CHANGE_ME_derived_from_JWT_SECRET_via_generate-supabase-keys.sh

# -----------------------------------------------------------------------------
# REALTIME (Phoenix / Elixir) — butuh 2 secret sendiri
# -----------------------------------------------------------------------------
# AES-128 key used by Realtime; must be exactly 16 characters.
REALTIME_ENC_KEY=CHANGE_ME_16char

# Generate: openssl rand -base64 48  (min 64 char).
REALTIME_SECRET_KEY_BASE=CHANGE_ME_realtime_secret_key_base_min_64_char

# -----------------------------------------------------------------------------
# KONG (basic auth ke Studio kalau di-expose — di prod biasanya tidak)
# -----------------------------------------------------------------------------
DASHBOARD_USERNAME=supabase
# Generate: openssl rand -base64 24
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password_min_16_char

# -----------------------------------------------------------------------------
# CONTROLDESK APP SECRETS
# -----------------------------------------------------------------------------
# App-level encryption key untuk kolom sensitif HRIS (salary, bank_account_number).
# Rules §22: rotate 90 hari. Generate: openssl rand -base64 32.
APP_ENCRYPTION_KEY=CHANGE_ME_app_encryption_key_openssl_rand_base64_32

# Bearer token untuk /api/cron/* endpoints (ai-insights sweep, dsb.).
# Generate: openssl rand -base64 32.
CRON_SECRET=CHANGE_ME_cron_secret_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# SMTP (email transactional)
# -----------------------------------------------------------------------------
# Rekomendasi provider: Resend (100 email/hari free), Postmark, AWS SES.
# Kalau pakai self-hosted mail (Postfix), pastikan SPF/DKIM/DMARC beres.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_CHANGE_ME_resend_api_key
SMTP_FROM=noreply@controldesk.app
SMTP_ADMIN_EMAIL=admin@controldesk.app
SMTP_SENDER_NAME=ControlDesk

# -----------------------------------------------------------------------------
# AI PROVIDER (opsional — kalau tidak diisi, AI Insights disabled)
# -----------------------------------------------------------------------------
# Salah satu / kombinasi. Prioritas fallback: Google > OpenAI > Anthropic.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# BACKUP (nightly pg_dump ke S3-compatible)
# -----------------------------------------------------------------------------
# Opsi provider hemat: Cloudflare R2 (10 GB free), Backblaze B2 ($6/TB/bulan),
# Wasabi ($6.99/TB/bulan). Semua support S3 API.
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=controldesk-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME_s3_access_key
BACKUP_S3_SECRET_KEY=CHANGE_ME_s3_secret_key
# Retensi daily backup (30 = simpan 30 hari). Rules §22 audit log 7 tahun
# ada di tabel Postgres — backup jadi copy tambahan.
BACKUP_RETENTION_DAILY=30

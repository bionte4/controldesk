{
  "name": "controldesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset --db-url \"$(supabase status --output env | grep DB_URL | cut -d= -f2 | tr -d '\"')\"",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "db:diff": "supabase db diff -f",
    "docker:deps": "docker compose --env-file .env.local up -d redis mailpit",
    "docker:deps:down": "docker compose --env-file .env.local stop redis mailpit",
    "docker:rebuild": "docker compose --env-file .env.local --profile prod build app",
    "docker:app": "docker compose --env-file .env.local --profile prod up -d app ai-insights-cron",
    "docker:app:down": "docker compose --env-file .env.local --profile prod stop app ai-insights-cron",
    "docker:refresh": "docker compose --env-file .env.local --profile prod build app && docker compose --env-file .env.local --profile prod up -d app ai-insights-cron && echo '\\n✓ Prod container refreshed at http://localhost:3001\\n  Tenant demo:    http://demo.localhost:3001\\n  Super-admin:    http://localhost:3001/super-admin\\n  Self-signup:    http://localhost:3001/register-org\\n  AI cron:        POST http://localhost:3001/api/cron/ai-insights-sweep (every 15 min via sidecar)'",
    "docker:logs": "docker compose --env-file .env.local logs -f",
    "test:wa": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/test-whatsapp-fonnte.ts",
    "fonnte:device": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/fonnte-device-status.ts",
    "test:ai": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/test-ai-insight.ts",
    "test:tg": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/test-telegram.ts",
    "tenant:create": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/tenant/create.ts",
    "help:reindex": "node --env-file=.env.local scripts/help-reindex.mjs",
    "gen:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "help:reindex:dry": "node --env-file=.env.local scripts/help-reindex.mjs --dry"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.40",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-pdf/renderer": "^4.5.1",
    "@serwist/turbopack": "^9.5.12",
    "@serwist/window": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.51",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "frappe-gantt": "1.2.2",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.12.0"
}
